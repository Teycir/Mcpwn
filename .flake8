[flake8]
max-line-length = 100
extend-ignore = E203,W503
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .benchmarks,
    htmlcov,
    .trunk
per-file-ignores =
    # Legacy tests predate the style guide; formatting-only rules are ignored
    # there. Logic and unused-import checks still apply.
    tests_unit/*:E302,E305,W291,W293
    test_data/dvmcp_server.py:E302,E501
